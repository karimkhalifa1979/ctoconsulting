{
  "name": "cems",
  "private": true,
  "version": "1.0.0",
  "description": "CTO Consulting — Consulting Engagement Management System (CEMS)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "seed": "node --disable-warning=ExperimentalWarning server/seed/run.mjs",
    "templates": "node scripts/build-starter-templates.mjs",
    "requirements": "node scripts/extract-requirements.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.15.0",
    "vite": "^8.3.5"
  }
}
