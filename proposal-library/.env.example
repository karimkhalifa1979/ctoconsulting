# Azure AD (Entra ID) app registration — Single-page application platform.
# Leave VITE_AZURE_CLIENT_ID empty to run the app in demo mode with sample data.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=organizations

# SharePoint site that holds the CTO Consulting document library.
VITE_SP_HOSTNAME=ctoconsul.sharepoint.com
VITE_SP_SITE_PATH=/sites/CTOConsulting
# Document library name ("Documents" is the default library, shown as "Shared Documents" in URLs).
VITE_SP_LIBRARY=Documents

# Folders inside the library.
VITE_CLIENTS_PATH=Clients
VITE_RESUMES_PATH=Sales and Marketing/People/Resumes/Originals
VITE_CASE_STUDIES_PATH=Sales and Marketing/Case Studies

# Where the saved selections live (a JSON file in the same library, shared by everyone using the app).
VITE_SELECTIONS_PATH=Sales and Marketing/Proposal Library/proposal-library-selections.json
